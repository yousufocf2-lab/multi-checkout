<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
  {%- if template == 'index' -%}{%- if settings.seo_home_title != blank -%}{%- assign page_title = settings.seo_home_title -%}{%- endif -%}{%- if settings.seo_home_description != blank -%}{%- assign page_description = settings.seo_home_description -%}{%- endif -%}{%- endif -%}
  {%- if settings.google_verification != blank -%}{%- assign gsv = settings.google_verification | split: 'content="' | last | split: '"' | first | strip -%}<meta name="google-site-verification" content="{{ gsv | escape }}">{%- endif -%}
  {%- if structured_data and preview != true -%}<script type="application/ld+json">{{ structured_data }}</script>{%- endif -%}
  <title>{{ page_title | default: shop.name }}{% if page_title and page_title != shop.name %}{% unless page_title contains shop.name %} · {{ shop.name }}{% endunless %}{% endif %}</title>
  {% if canonical_url != blank %}<link rel="canonical" href="{{ canonical_url | escape }}">{% endif %}
  {% if page_description %}<meta name="description" content="{{ page_description | strip_html | truncate: 160 | escape }}">{% endif %}
  {% if preview %}<meta name="robots" content="noindex">{% endif %}
  <meta property="og:title" content="{{ page_title | default: shop.name | escape }}">
  {% if page_description %}<meta property="og:description" content="{{ page_description | strip_html | truncate: 200 | escape }}">{% endif %}
  <meta property="og:site_name" content="{{ shop.name | escape }}">
  {% if og_image %}<meta property="og:image" content="{{ og_image | img_url: 1200 }}">{% endif %}
  <meta name="theme-color" content="{{ settings.color_hero_bg | default: '#1f1a17' }}">
  {%- assign favicon = settings.favicon | default: shop.favicon -%}
  <link rel="icon" href="{{ favicon }}">
  <link rel="apple-touch-icon" href="{{ favicon }}">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  {%- assign fh = settings.font_heading | default: 'Bricolage Grotesque' -%}{%- assign fb = settings.font_body | default: 'Inter' -%}
  <link href="https://fonts.googleapis.com/css2?family={{ fh | replace: ' ', '+' }}:wght@500;600;700;800{% if fb != fh %}&family={{ fb | replace: ' ', '+' }}:wght@400;500;600;700{% endif %}&display=swap" rel="stylesheet">
  <style>{{ 'theme.css' | asset_content }}</style>
  <style>:root{
    --brand:{{ settings.color_brand | default: '#e4572e' }};
    --btn-text:{{ settings.color_button_text | default: '#ffffff' }};
    --bg:{{ settings.color_bg | default: '#fbf7f2' }};
    --card:{{ settings.color_card | default: '#ffffff' }};
    --ink:{{ settings.color_text | default: '#1f1a17' }};
    --soft:{{ settings.color_muted | default: '#756c64' }};
    --line:{{ settings.color_line | default: '#ece4da' }};
    --hero:{{ settings.color_hero_bg | default: '#1f1a17' }};
    --hero-ink:{{ settings.color_hero_text | default: '#fff7ee' }};
    --font-heading:"{{ fh }}";
    --font-body:"{{ fb }}";
    --r:{{ settings.radius | default: 16 }}px;
    --logo-w:{{ settings.logo_width | default: 120 }}px;
    --logo-w-m:{{ settings.logo_width_mobile | default: 96 }}px;
  }</style>
  {%- if shop.meta_pixel and editor != true and preview_draft != true -%}
  <script>!function(f,b,e,v,n,t,s){if(f.fbq)return;n=f.fbq=function(){n.callMethod?n.callMethod.apply(n,arguments):n.queue.push(arguments)};if(!f._fbq)f._fbq=n;n.push=n;n.loaded=!0;n.version='2.0';n.queue=[];t=b.createElement(e);t.async=!0;t.src=v;s=b.getElementsByTagName(e)[0];s.parentNode.insertBefore(t,s)}(window,document,'script','https://connect.facebook.net/en_US/fbevents.js');fbq('init','{{ shop.meta_pixel }}');fbq('track','PageView');</script>
  {%- endif -%}
  {% if settings.custom_css != blank %}<style>{{ settings.custom_css }}</style>{% endif %}
  {% if editor %}<style>[data-gp-section]{display:contents}[data-gp-section]>*{cursor:pointer}[data-gp-section]>*:hover{outline:1px dashed #2563eb;outline-offset:-1px}[data-gp-section].gp-hl>*{outline:2px solid #2563eb!important;outline-offset:-2px}</style>{% endif %}
</head>
<body class="fs fs--{{ template }}" data-shop="{{ shop.slug }}" data-root="{{ routes.base }}" data-open="{% if restaurant == null or restaurant.open %}1{% else %}0{% endif %}">
  <script type="application/json" id="fs-rest">{% if restaurant %}{{ restaurant.json }}{% else %}{"open":true,"modes":{"delivery":true,"takeaway":false,"dine_in":false},"minDelivery":0,"minTakeaway":0,"needsLocation":false,"tables":[]}{% endif %}</script>
  {{ content_for_header_group }}
  <main id="main" class="fs-main">{{ content_for_layout }}</main>
  {{ content_for_footer_group }}

  {%- comment -%} Sticky cart bar (phones and computers) {%- endcomment -%}
  <button type="button" class="cartbar" data-cartbar hidden>
    <span class="cartbar__n"><b data-cartbar-n>0</b> <span data-cartbar-items>items</span></span>
    <span class="cartbar__sum" data-cartbar-sum></span>
    <span class="cartbar__go">View cart {% render 'snippets/icon', name: 'arrow' %}</span>
  </button>

  {%- comment -%} Dish options: size + add-ons {%- endcomment -%}
  <div class="sheet" data-sheet="dish" hidden>
    <div class="sheet__shade" data-close></div>
    <section class="sheet__panel" role="dialog" aria-modal="true" aria-labelledby="dish-title">
      <header class="sheet__head"><div><p class="sheet__eyebrow" data-dish-diet></p><h2 id="dish-title" data-dish-title></h2><p class="sheet__sub" data-dish-price></p></div><button type="button" class="sheet__x" data-close aria-label="Close">{% render 'snippets/icon', name: 'close' %}</button></header>
      <div class="sheet__body" data-dish-body></div>
      <footer class="sheet__foot">
        <div class="qty" data-dish-qty><button type="button" data-q="-1" aria-label="Less">−</button><b>1</b><button type="button" data-q="1" aria-label="More">+</button></div>
        <button type="button" class="btn btn--grow" data-dish-add>Add item</button>
      </footer>
      <p class="sheet__err" data-dish-err hidden></p>
    </section>
  </div>

  {%- comment -%} Cart {%- endcomment -%}
  <div class="sheet sheet--cart" data-sheet="cart" hidden>
    <div class="sheet__shade" data-close></div>
    <section class="sheet__panel" role="dialog" aria-modal="true" aria-labelledby="cart-title">
      <header class="sheet__head"><div><h2 id="cart-title">Your order</h2><p class="sheet__sub">{{ shop.name }}</p></div><button type="button" class="sheet__x" data-close aria-label="Close">{% render 'snippets/icon', name: 'close' %}</button></header>
      <div class="sheet__body">
        <div class="modes" data-modes role="tablist" aria-label="How do you want your food?"></div>
        <div class="where" data-where></div>
        <div class="lines" data-lines></div>
        <p class="empty" data-empty hidden>Your cart is empty. Add something tasty from the menu.</p>
        {%- if settings.cart_note != blank -%}<p class="note">{{ settings.cart_note }}</p>{%- endif -%}
      </div>
      <footer class="sheet__foot sheet__foot--col">
        <p class="warn" data-cart-warn hidden></p>
        <div class="tot"><span>Item total</span><b data-cart-total></b></div>
        <button type="button" class="btn btn--block" data-checkout>Proceed to checkout {% render 'snippets/icon', name: 'arrow' %}</button>
        <p class="sheet__err" data-checkout-err hidden></p>
      </footer>
    </section>
  </div>

  {%- if settings.whatsapp_number != blank -%}
  <a class="wa" href="https://wa.me/{{ settings.whatsapp_number | remove: ' ' | remove: '+' | remove: '-' }}" target="_blank" rel="noopener" aria-label="Chat on WhatsApp"><svg width="26" height="26" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 2a10 10 0 0 0-8.6 15.1L2 22l5-1.3A10 10 0 1 0 12 2zm5.3 14.1c-.2.6-1.3 1.2-1.8 1.2-.5.1-1 .2-3.3-.7-2.8-1.1-4.6-4-4.7-4.2-.1-.2-1.1-1.5-1.1-2.9s.7-2 1-2.3c.3-.3.6-.3.8-.3h.6c.2 0 .4 0 .6.5l.9 2.1c.1.2.1.4 0 .5l-.4.6-.4.4c-.1.1-.3.3-.1.6.2.3.8 1.3 1.7 2.1 1.2 1 2.1 1.4 2.4 1.5.3.1.5.1.6-.1l.9-1c.2-.3.4-.2.6-.1l2 .9c.3.1.5.2.5.3.1.2.1.7-.1 1.3z"/></svg></a>
  {%- endif -%}
  <div class="toast" id="toast" role="status" aria-live="polite"></div>
  <script>{{ 'theme.js' | asset_content }}</script>
  {%- unless editor -%}
  <script>
  (function(){try{
    var u;try{u=sessionStorage.getItem('gp_visit_id');if(!u){u=(crypto.randomUUID?crypto.randomUUID():Date.now().toString(36)+Math.random().toString(36).slice(2));sessionStorage.setItem('gp_visit_id',u)}}catch(e){u=Date.now().toString(36)+Math.random().toString(36).slice(2)}
    var v={s:{{ shop.slug | json }},p:location.pathname,d:matchMedia('(min-width:861px)').matches?'desktop':'mobile',u:u,cls:0},sent=false;
    new PerformanceObserver(function(l){var e=l.getEntries();if(e.length)v.lcp=e[e.length-1].startTime}).observe({type:'largest-contentful-paint',buffered:true});
    new PerformanceObserver(function(l){l.getEntries().forEach(function(e){if(!e.hadRecentInput)v.cls+=e.value})}).observe({type:'layout-shift',buffered:true});
    function send(){if(sent)return;sent=true;v.cls=Math.round(v.cls*1000)/1000;var body=JSON.stringify(v);if(!navigator.sendBeacon||!navigator.sendBeacon('/api/vitals',body))fetch('/api/vitals',{method:'POST',body:body,keepalive:true,mode:'no-cors'})}
    addEventListener('visibilitychange',function(){if(document.visibilityState==='hidden')send()});addEventListener('pagehide',send);
  }catch(e){}})();
  /* Order source: the first and latest marketing visit (utm tags, ad click, referrer), read by the checkout */
  (function(){try{
    var q=new URLSearchParams(location.search),ref='',host=location.hostname.replace(/^www\./,'');
    try{ref=document.referrer?new URL(document.referrer).hostname.replace(/^www\./,''):''}catch(e){}
    if(ref===host||/growpefy|payu|razorpay|cashfree|phonepe|paytm|shiprocket|delhivery/i.test(ref))ref='';
    var k=['gclid','gbraid','wbraid','fbclid','msclkid'].filter(function(x){return q.get(x)})[0];
    function c(v,n){return v?String(v).replace(/[^\w .:\/@+-]/g,'').slice(0,n)||undefined:undefined}
    var t={s:c(q.get('utm_source'),40),m:c(q.get('utm_medium'),40),c:c(q.get('utm_campaign'),80),t:c(q.get('utm_term'),80),k:k,r:c(ref,60),lp:c(location.pathname,60),at:Date.now()};
    var m=document.cookie.match(/(?:^|; )gp_vs=([^;]*)/),old=null;try{old=m?JSON.parse(decodeURIComponent(m[1])):null}catch(e){}
    if(old&&!(t.s||t.k||t.r))return;
    document.cookie='gp_vs='+encodeURIComponent(JSON.stringify({f:(old&&old.f)||t,l:t}))+'; Max-Age=7776000; Path=/; SameSite=Lax'+(location.protocol==='https:'?'; Secure':'');
  }catch(e){}})();
  (function(){try{
    var u=sessionStorage.getItem('gp_visit_id');if(!u)return;
    var src=sessionStorage.getItem('gp_src');
    if(src==null){var q=new URLSearchParams(location.search),ua=navigator.userAgent,ref='';try{ref=document.referrer?new URL(document.referrer).hostname:''}catch(e){}
      src=q.get('utm_source')||(/Instagram/i.test(ua)?'instagram':/FBAN|FBAV|FB_IAB/i.test(ua)?'facebook':'')||(q.get('fbclid')?'facebook':q.get('gclid')?'google':'')||(q.get('table')?'table-qr':'')||(ref&&ref!==location.hostname?ref:'')||'direct';
      try{sessionStorage.setItem('gp_src',src)}catch(e){}}
    var shop={{ shop.slug | json }},root=document.body.getAttribute('data-root')||'',dev=matchMedia('(min-width:861px)').matches?'desktop':'mobile';
    function cart(){try{var c=JSON.parse(localStorage.getItem('gp_cart_'+shop)||'[]');return c.reduce(function(a,l){a.q+=l.qty||0;a.v+=(l.price||0)*(l.qty||0);return a},{q:0,v:0})}catch(e){return{q:0,v:0}}}
    function beat(leave){var c=cart(),b=JSON.stringify({s:shop,u:u,p:location.pathname,r:root,d:dev,t:document.title,src:src,q:c.q,v:c.v,e:leave?'leave':undefined});
      if(leave){if(!navigator.sendBeacon||!navigator.sendBeacon('/api/live',b))fetch('/api/live',{method:'POST',body:b,keepalive:true,mode:'no-cors'});return}
      fetch('/api/live',{method:'POST',body:b,keepalive:true,mode:'no-cors'}).catch(function(){})}
    var t;function loop(){clearInterval(t);t=setInterval(function(){if(document.visibilityState==='visible')beat()},15000)}
    beat();loop();
    var d;document.addEventListener('gp:cart',function(){clearTimeout(d);d=setTimeout(function(){beat()},400)});
    addEventListener('visibilitychange',function(){if(document.visibilityState==='visible'){beat();loop()}});
    addEventListener('pagehide',function(){beat(true)});
  }catch(e){}})();
  </script>
  {%- endunless -%}
  {% if editor %}<script>
  (function(){
    function hl(id, scroll){ document.querySelectorAll('.gp-hl').forEach(function(e){e.classList.remove('gp-hl')}); if(!id) return; var el=document.querySelector('[data-gp-section="'+id+'"]'); if(el){ el.classList.add('gp-hl'); var f=el.firstElementChild; if(scroll&&f){ var r=f.getBoundingClientRect(); if(r.top<70||r.top>innerHeight*0.6) window.scrollTo({top:Math.max(0,r.top+scrollY-80),behavior:'smooth'}); } } }
    window.addEventListener('message', function(e){ var d=e.data||{}; if(d.gp === 'select') hl(d.id, true); if(d.gp === 'vars'){ for(var k in d.vars) document.documentElement.style.setProperty(k, d.vars[k]); } });
    document.addEventListener('click', function(e){ var s=e.target.closest('[data-gp-section]'); if(!s) return; e.preventDefault(); e.stopPropagation(); hl(s.getAttribute('data-gp-section')); parent.postMessage({gp:'clicked', id:s.getAttribute('data-gp-section'), group:s.getAttribute('data-gp-group')}, '*'); }, true);
    parent.postMessage({gp:'ready'}, '*');
  })();
  </script>{% endif %}
</body>
</html>
