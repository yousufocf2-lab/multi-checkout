{%- assign s = section.settings -%}
<section class="press sec">
  <div class="pw">
    <div class="sec__head">
      <div>{%- if s.eyebrow != blank -%}<p class="sec__eye">{{ s.eyebrow }}</p>{%- endif -%}{%- if s.heading != blank -%}<h2 class="sec__h">{{ s.heading }}</h2>{%- endif -%}</div>
    </div>
    <div class="press__row" data-drag-scroll>
      {%- for it in s.items -%}
      <figure class="press__it">
        {%- if it.image != blank -%}<img src="{{ it.image | img_url: 600 }}" alt="{{ it.title | escape }}" loading="lazy">
        {%- else -%}<span class="press__ic">{% render 'snippets/icon', name: 'medal', stroke: '1.5' %}</span>{%- endif -%}
        <figcaption><b>{{ it.title }}</b>{%- if it.year != blank -%}<small>{{ it.year }}</small>{%- endif -%}</figcaption>
      </figure>
      {%- endfor -%}
    </div>
  </div>
</section>
{% schema %}
{ "name": "Awards & press", "category": "Trust", "description": "Award photos or press mentions as neat cards in a row", "settings": [
  { "id": "eyebrow", "type": "text", "label": "Small line above", "default": "Recognised for what we build" },
  { "id": "heading", "type": "text", "label": "Heading", "default": "Awards & press" },
  { "id": "items", "type": "list", "label": "Awards", "item_label": "award", "max_items": 12, "fields": [
    { "id": "image", "type": "image", "label": "Photo or logo (optional)" },
    { "id": "title", "type": "text", "label": "Award or publication" },
    { "id": "year", "type": "text", "label": "Year or short note" }
  ], "default": [
    { "title": "Brand of the Year", "year": "2025" }, { "title": "Best Audio Startup", "year": "2024" }, { "title": "Design Excellence", "year": "2024" }, { "title": "Customer Choice", "year": "2023" }
  ] }
] }
{% endschema %}
