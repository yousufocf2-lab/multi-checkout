{%- assign s = section.settings -%}
<section class="blog sec">
  <div class="pw">
    {%- if s.heading != blank -%}<div class="sec__head"><h2 class="sec__h">{{ s.heading }}</h2></div>{%- endif -%}
    <div class="blog__wrap" data-slider>
      <div class="blog__track" data-track>
        {%- for it in s.items -%}
        <a class="post" href="{{ it.link | safe_url | default: '#' }}" data-slide>
          <span class="post__img">{%- if it.image != blank -%}<img src="{{ it.image | img_url: 700 }}" alt="" loading="lazy">{%- endif -%}</span>
          <span class="post__body">
            {%- if it.date != blank -%}<small class="post__date">{{ it.date }}</small>{%- endif -%}
            <b class="post__t">{{ it.title }}</b>
            {%- if it.excerpt != blank -%}<span class="post__x">{{ it.excerpt }}</span>{%- endif -%}
            <span class="post__more">{{ s.more | default: 'Read more' }} {% render 'snippets/icon', name: 'right' %}</span>
          </span>
        </a>
        {%- endfor -%}
      </div>
      <button type="button" class="sl-arrow sl-arrow--prev" data-prev aria-label="Previous">{% render 'snippets/icon', name: 'left' %}</button>
      <button type="button" class="sl-arrow sl-arrow--next" data-next aria-label="Next">{% render 'snippets/icon', name: 'right' %}</button>
    </div>
  </div>
</section>
{% schema %}
{ "name": "Blog posts", "category": "Content", "description": "Article cards with image, date, title and a short summary", "settings": [
  { "id": "heading", "type": "text", "label": "Heading", "default": "From the blog" },
  { "id": "more", "type": "text", "label": "Link text", "default": "Read more" },
  { "id": "items", "type": "list", "label": "Posts", "item_label": "post", "max_items": 12, "fields": [
    { "id": "title", "type": "text", "label": "Title" },
    { "id": "image", "type": "image", "label": "Image" },
    { "id": "date", "type": "text", "label": "Date (for example 12 Nov 2026)" },
    { "id": "excerpt", "type": "textarea", "label": "Short summary" },
    { "id": "link", "type": "url", "label": "Link (a page in Storefront → Site pages, or any link)" }
  ], "default": [
    { "title": "How to register your product warranty", "date": "12 Nov 2026", "excerpt": "Three quick steps to register your purchase and keep your warranty active." },
    { "title": "Choosing the right earbuds for your day", "date": "02 Nov 2026", "excerpt": "ANC, battery, fit and calls: what actually matters when you pick a pair." },
    { "title": "Care tips that keep your gadgets new", "date": "24 Oct 2026", "excerpt": "Simple habits for charging, cleaning and storing your devices." }
  ] }
] }
{% endschema %}
