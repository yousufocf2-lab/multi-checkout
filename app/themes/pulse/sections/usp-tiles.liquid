{%- assign s = section.settings -%}
<section class="promise sec">
  <div class="pw">
    <div class="promise__head">
      {%- if s.eyebrow != blank -%}<p class="sec__eye">{{ s.eyebrow }}</p>{%- endif -%}
      <h2 class="sec__h promise__h">{{ s.heading }}</h2>
      {%- if s.text != blank -%}<p class="promise__t">{{ s.text }}</p>{%- endif -%}
    </div>
    <div class="promise__grid" style="--n:{{ s.items.size | default: 4 }}">
      {%- for it in s.items -%}
      <div class="promise__it">
        <span class="promise__ic">{%- if it.image != blank -%}<img src="{{ it.image | img_url: 120 }}" alt="" loading="lazy">{%- else -%}{% render 'snippets/icon', name: it.icon, stroke: '1.6' %}{%- endif -%}</span>
        <b>{{ it.title }}</b>
        {%- if it.text != blank -%}<p>{{ it.text }}</p>{%- endif -%}
      </div>
      {%- endfor -%}
    </div>
  </div>
</section>
{% schema %}
{ "name": "Our promise", "category": "Trust", "description": "A short promise with icon cards (warranty, delivery, support…)", "settings": [
  { "id": "eyebrow", "type": "text", "label": "Small line above", "default": "Why people stay with us" },
  { "id": "heading", "type": "text", "label": "Heading", "default": "Built to last. Backed by people." },
  { "id": "text", "type": "textarea", "label": "Text (optional)", "default": "" },
  { "id": "items", "type": "list", "label": "Cards", "item_label": "card", "max_items": 6, "fields": [
    { "id": "icon", "type": "select", "label": "Icon", "options": ["shield", "truck", "headphones", "refresh", "badge", "cash", "lock", "crown", "gift", "bolt", "receipt", "box", "medal", "wheel"], "default": "shield" },
    { "id": "image", "type": "image", "label": "Your own icon (optional)" },
    { "id": "title", "type": "text", "label": "Title" },
    { "id": "text", "type": "text", "label": "Line" }
  ], "default": [
    { "icon": "shield", "title": "1-year warranty", "text": "Replacement, not runarounds." },
    { "icon": "truck", "title": "Ships in 24 hours", "text": "Tracked delivery across India." },
    { "icon": "headphones", "title": "Real human support", "text": "WhatsApp us, 7 days a week." },
    { "icon": "refresh", "title": "7-day replacement", "text": "Not right? We’ll make it right." }
  ] }
] }
{% endschema %}
