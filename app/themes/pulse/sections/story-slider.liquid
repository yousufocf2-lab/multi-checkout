{%- assign s = section.settings -%}
<section class="story sec">
  <div class="pw story__wrap" data-slider data-autoplay="{{ s.autoplay | default: 0 }}">
    <div class="story__track" data-track>
      {%- for it in s.items -%}
      <div class="story__slide" data-slide>
        <div class="story__card">
          <div class="story__media">{%- if it.video != blank -%}<video src="{{ it.video }}" muted loop playsinline preload="none" data-inview-play {% if it.image != blank %}poster="{{ it.image | img_url: 900 }}"{% endif %}></video>{%- elsif it.image != blank -%}<img src="{{ it.image | img_url: 900 }}" alt="" loading="lazy">{%- else -%}<span class="reel__ph"></span>{%- endif -%}</div>
          <div class="story__copy">
            {%- if it.light != blank -%}<p class="story__light">{{ it.light }}</p>{%- endif -%}
            {%- if it.bold != blank -%}<h3 class="story__bold">{{ it.bold }}</h3>{%- endif -%}
            {%- if it.text != blank -%}<p class="story__t">{{ it.text }}</p>{%- endif -%}
            {%- if it.button != blank -%}<a class="btn" href="{{ it.link | safe_url }}">{{ it.button }}</a>{%- endif -%}
          </div>
        </div>
      </div>
      {%- endfor -%}
    </div>
    {%- if s.items.size > 1 -%}
    <button type="button" class="sl-arrow sl-arrow--next" data-next aria-label="Next">{% render 'snippets/icon', name: 'right' %}</button>
    <div class="story__bars" data-dots></div>
    {%- endif -%}
  </div>
</section>
{% schema %}
{ "name": "Brand story slider", "category": "Media", "description": "Big rounded cards: photo on one side, a two-tone heading and text on the other", "settings": [
  { "id": "autoplay", "type": "range", "label": "Change slide every (0 = never)", "min": 0, "max": 12, "step": 1, "unit": " s", "default": 6 },
  { "id": "items", "type": "list", "label": "Slides", "item_label": "slide", "max_items": 8, "fields": [
    { "id": "image", "type": "image", "label": "Photo" },
    { "id": "video", "type": "video", "label": "Or a video" },
    { "id": "light", "type": "text", "label": "Heading, first line (light)" },
    { "id": "bold", "type": "text", "label": "Heading, second line (bold)" },
    { "id": "text", "type": "textarea", "label": "Text" },
    { "id": "button", "type": "text", "label": "Button (optional)" },
    { "id": "link", "type": "url", "label": "Button link" }
  ], "default": [
    { "light": "Designed to", "bold": "Stand apart", "text": "We don’t just engineer what’s inside. Every finish, curve and detail is designed to look and feel as good as it sounds." },
    { "light": "Tuned for", "bold": "Everyday life", "text": "Long battery, clear calls and quick pairing, made for commutes, workouts and late-night playlists." }
  ] }
] }
{% endschema %}
