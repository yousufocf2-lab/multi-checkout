{%- assign s = section.settings -%}
{%- unless s.hidden -%}
<div class="tick{% if s.hide_mobile %} tick--hide-m{% endif %}" style="--tick-bg:{{ s.bg | default: '#0e0f12' }};--tick-ink:{{ s.text_color | default: '#ffffff' }}">
  <div class="tick__in pw">
    {%- if s.label != blank -%}<span class="tick__live"><i></i>{{ s.label }}</span>{%- endif -%}
    <div class="tick__msgs" style="--speed:{{ s.speed | default: 26 }}s">
      <div class="tick__track">
        {%- for round in (1..2) -%}
        <div class="tick__set"{% if round == 2 %} aria-hidden="true"{% endif %}>
          {%- for m in s.messages -%}
          {%- if m.link != blank -%}<a href="{{ m.link | safe_url }}" class="tick__m"{% if round == 2 %} tabindex="-1"{% endif %}>{{ m.text }}</a>{%- else -%}<span class="tick__m">{{ m.text }}</span>{%- endif -%}
          {%- endfor -%}
        </div>
        {%- endfor -%}
      </div>
    </div>
    {%- if s.show_timer -%}
    <a class="tick__timer" href="{{ s.link | safe_url | default: routes.all }}" data-countdown="{{ s.ends_at | escape }}">
      <span class="tick__ends">{{ s.timer_label | default: 'Ends in' }}</span>
      <b><i data-d data-auto hidden></i><i data-h>00</i>:<i data-m>00</i>:<i data-s>00</i></b>
    </a>
    {%- endif -%}
  </div>
</div>
{%- endunless -%}
{% schema %}
{ "name": "Deal ticker", "category": "Content", "description": "Slim top bar: live label, moving offer messages and a countdown", "settings": [
  { "id": "hidden", "type": "checkbox", "label": "Hide this bar", "default": false },
  { "id": "hide_mobile", "type": "checkbox", "label": "Hide on phones", "default": false },
  { "id": "label", "type": "text", "label": "Label on the left (empty = none)", "default": "Live deals" },
  { "id": "messages", "type": "list", "label": "Messages", "item_label": "message", "max_items": 8, "fields": [
    { "id": "text", "type": "text", "label": "Message" }, { "id": "link", "type": "url", "label": "Link (optional)" }
  ], "default": [
    { "text": "Up to 70% off on audio and wearables" }, { "text": "Free delivery on prepaid orders" }, { "text": "1-year warranty on every product" }, { "text": "Cash on delivery available" }
  ] },
  { "id": "speed", "type": "range", "label": "Message speed (one loop takes)", "min": 10, "max": 60, "step": 2, "unit": " s", "default": 26 },
  { "type": "header", "id": "h_timer", "label": "Countdown" },
  { "id": "show_timer", "type": "checkbox", "label": "Show countdown", "default": true },
  { "id": "timer_label", "type": "text", "label": "Countdown text", "default": "Sale ends in" },
  { "id": "ends_at", "type": "datetime", "label": "Offer ends at", "default": "" },
  { "id": "link", "type": "url", "label": "Countdown link", "default": "/products/all" },
  { "type": "header", "id": "h_look", "label": "Look" },
  { "id": "bg", "type": "color", "label": "Background", "default": "#0e0f12" },
  { "id": "text_color", "type": "color", "label": "Text", "default": "#ffffff" }
] }
{% endschema %}
