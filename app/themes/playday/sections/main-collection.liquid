{%- assign s = section.settings -%}
{%- assign items = collection.products -%}
{%- assign use_filters = false -%}
{%- if s.show_filters != false and collection.filters.enabled -%}{%- assign use_filters = true -%}{%- endif -%}
{%- assign lay = s.filter_layout | default: 'store' -%}{%- if lay == 'store' -%}{%- assign lay = collection.filters.layout -%}{%- endif -%}
<section class="toy-collection">
  {%- if s.banner != blank and collection.search == nil -%}
    <div class="toy-collection__banner"><picture>{%- if s.banner_mobile != blank -%}<source media="(max-width:749px)" srcset="{{ s.banner_mobile | img_url: 900 }}">{%- endif -%}<img src="{{ s.banner | img_url: 1920 }}" alt="{{ collection.title | escape }}" fetchpriority="high"></picture><span>{{ s.banner_note | default: 'A little wonder for every day' }}</span></div>
  {%- endif -%}
  <div class="pw toy-collection__inner">
    <nav class="toy-collection__crumbs" aria-label="Breadcrumb"><a href="{{ routes.root }}">Home</a><span>›</span><span>{{ collection.title }}</span></nav>
    {%- if collection.search -%}
      <form action="{{ routes.search }}" method="get" class="toy-collection__search" role="search">{% render 'snippets/icon', name: 'search' %}<input type="search" name="q" value="{{ collection.search.q | escape }}" placeholder="Search the toy box" aria-label="Search products" autocomplete="off"><button type="submit" class="btn btn--sm">Search</button></form>
      {%- if collection.search.categories.size > 0 -%}<div class="srch__pop">{%- for c in collection.search.categories -%}<a href="{{ c.url }}">{{ c.title }}</a>{%- endfor -%}</div>{%- endif -%}
    {%- endif -%}
    <header class="toy-collection__head"><div><p class="toy-collection__eyebrow">The Playday toy box</p><h1>{{ collection.title }}</h1></div><span class="toy-collection__count">{{ items.size }} {% if items.size == 1 %}toy{% else %}toys{% endif %}</span></header>
    {%- capture grid -%}
      {%- if items.size > 0 -%}
        <div class="toy-collection__grid" style="--cols:{{ s.columns | default: 3 }}">{%- for p in items -%}<div class="toy-collection__cell">{% render 'snippets/product-card', product: p, settings: settings %}</div>{%- endfor -%}</div>
      {%- elsif collection.filters.active_count > 0 -%}
        <div class="toy-collection__empty"><span aria-hidden="true">✳</span><h2>No toys found for this mix</h2><p>Try another filter or start with the full toy box.</p><a href="{{ collection.filters.clear_url | escape }}" class="btn">Clear filters</a></div>
      {%- else -%}
        <div class="toy-collection__empty"><span aria-hidden="true">✳</span><h2>The toy box is getting ready</h2><p>There are no toys in this collection just yet.</p><a href="{{ routes.all }}" class="btn">Explore all toys</a></div>
      {%- endif -%}
    {%- endcapture -%}
    {%- if use_filters -%}{% render 'snippets/filters', f: collection.filters, grid: grid, layout: lay %}{%- else -%}{{ grid }}{%- endif -%}
    {%- if collection.description != blank -%}<div class="toy-collection__seo"><div class="rte rte--clamp" data-clamp>{{ collection.description }}</div><button type="button" class="rtx__more" data-clamp-btn aria-label="Read more">{% render 'snippets/icon', name: 'down' %}</button></div>{%- endif -%}
  </div>
</section>
{% schema %}
{ "name": "Toy category page", "category": "Products", "description": "Playday category page with a story-style heading, toy cards and the store's configurable filters", "settings": [
  { "id": "banner", "type": "image", "label": "Category story image (optional)" },
  { "id": "banner_mobile", "type": "image", "label": "Phone image (optional)" },
  { "id": "banner_note", "type": "text", "label": "Small line on the image", "default": "A little wonder for every day" },
  { "id": "columns", "type": "range", "label": "Products per row (computer)", "min": 2, "max": 5, "step": 1, "default": 3 },
  { "type": "header", "id": "h_filters", "label": "Filters" },
  { "type": "paragraph", "id": "p_filters", "label": "Filter options, order and style are set in Settings → Widgets → Product filters." },
  { "type": "checkbox", "id": "show_filters", "label": "Show product filters", "default": true },
  { "type": "select", "id": "filter_layout", "label": "Filter position", "default": "store", "options": ["store", "sidebar", "top", "drawer"], "option_labels": ["Use store setting", "Sidebar", "Top bar", "Slide-out panel"] }
] }
{% endschema %}
