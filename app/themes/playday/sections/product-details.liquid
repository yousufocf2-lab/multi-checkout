{%- assign s = section.settings -%}
<section class="toy-details" id="pdx-desc">
  <nav class="toy-details__nav" data-pdx-tabs aria-label="Product information">
    <a href="#pdx-desc" class="is-on">The details</a><a href="#reviews">Reviews</a>
  </nav>
  <div class="pw toy-details__body">
    <header class="toy-details__head"><p class="toy-details__eyebrow">A closer look</p><h2>{{ s.heading | default: 'Made for play' }}</h2><p>Everything you need to know before it joins the toy box.</p></header>
    {%- if product.usp.size > 0 or product.specs.size > 0 -%}
      <div class="toy-details__facts">
        {%- if product.usp.size > 0 -%}<section class="toy-details__features"><h3>{{ s.usp_title | default: 'Why little ones love it' }}</h3><ul>{%- for u in product.usp -%}<li>{% render 'snippets/icon', name: 'check' %}<span>{{ u }}</span></li>{%- endfor -%}</ul></section>{%- endif -%}
        {%- if product.specs.size > 0 -%}<section class="toy-details__specs"><h3>{{ s.specs_title | default: 'The little details' }}</h3><dl>{%- for sp in product.specs -%}<div><dt>{{ sp.label }}</dt><dd>{{ sp.value }}</dd></div>{%- endfor -%}</dl></section>{%- endif -%}
      </div>
    {%- endif -%}
    {%- if product.description != blank -%}<article class="toy-details__story rte"><span class="toy-details__spark" aria-hidden="true">✳</span>{{ product.description }}</article>{%- endif -%}
    {%- if product.banners.size > 0 -%}<div class="toy-details__banners">{%- for b in product.banners -%}{%- if b.link != blank -%}<a href="{{ b.link | safe_url }}" class="toy-details__banner">{%- else -%}<div class="toy-details__banner">{%- endif -%}<picture>{%- if b.mobile != blank -%}<source media="(max-width:749px)" srcset="{{ b.mobile | img_url: 900 }}">{%- endif -%}<img src="{{ b.image | img_url: 1800 }}" alt="{{ b.alt | escape }}" loading="lazy" width="1600" height="800"></picture>{%- if b.link != blank -%}</a>{%- else -%}</div>{%- endif -%}{%- endfor -%}</div>{%- endif -%}
    {%- assign has_info = false -%}{%- if product.product_type != blank or product.origin != blank or s.info_rows.size > 0 -%}{%- assign has_info = true -%}{%- endif -%}
    {%- if s.show_info and has_info -%}<aside class="toy-details__origin"><h3>{{ s.info_title | default: 'Toy box notes' }}</h3>{%- if product.product_type != blank -%}<p><span>Type</span><b>{{ product.product_type }}</b></p>{%- endif -%}{%- if product.origin != blank -%}<p><span>Made in</span><b>{{ product.origin }}</b></p>{%- endif -%}{%- for r in s.info_rows -%}{%- if r.label != blank and r.value != blank -%}<p><span>{{ r.label }}</span><b>{{ r.value }}</b></p>{%- endif -%}{%- endfor -%}</aside>{%- endif -%}
  </div>
</section>
{% schema %}
{ "name": "Toy details", "category": "Products", "description": "Playday story layout for product features, specifications and description imagery", "settings": [
  { "id": "heading", "type": "text", "label": "Section heading", "default": "Made for play" },
  { "id": "usp_title", "type": "text", "label": "Feature card heading", "default": "Why little ones love it" },
  { "id": "specs_title", "type": "text", "label": "Specification card heading", "default": "The little details" },
  { "id": "show_info", "type": "checkbox", "label": "Show product information card", "default": true },
  { "id": "info_title", "type": "text", "label": "Information card heading", "default": "Toy box notes" },
  { "id": "info_rows", "type": "list", "label": "Extra information rows", "item_label": "row", "max_items": 12, "fields": [{ "id": "label", "type": "text", "label": "Label" }, { "id": "value", "type": "text", "label": "Value" }], "default": [] },
  { "type": "paragraph", "id": "p_help", "label": "Features, specifications, age and description pictures come from the product catalogue." }
] }
{% endschema %}
