{%- assign s = section.settings -%}
{%- assign w = widgets.reviews -%}
{%- if reviews_enabled -%}
<section class="sec" id="{{ section.id }}">
  <div class="pw">
    {% render 'snippets/review-box', product: product, reviews: reviews, count: review_count, average: review_average, breakdown: review_breakdown, media_count: review_media_count, published: review_published, submitted: review_submitted, w: widgets.reviews, ui: review_ui, shop: shop, heading: s.heading, write_label: s.write_label, show_gallery: s.show_gallery %}
  </div>
</section>
{%- elsif editor -%}
<section class="sec"><div class="pw"><p class="empty">Reviews are switched off. Turn them on in Settings → Widgets.</p></div></section>
{%- endif -%}
{% schema %}
{ "name": "Product reviews", "category": "Trust", "requires": "reviews", "description": "Rating summary with bars, filters, customer photos and videos, and a step-by-step review form", "settings": [
  { "id": "heading", "type": "text", "label": "Heading", "default": "Customer reviews" },
  { "id": "write_label", "type": "text", "label": "Button text", "default": "Write a review" },
  { "id": "show_gallery", "type": "checkbox", "label": "Show customer photos and videos in a strip on top", "default": true },
  { "type": "paragraph", "id": "p_more", "label": "Shoppers rate in easy steps: tap a star, write (with quick phrases), add photos or a video, then their name. Colours, approval rules and photo/video limits are in Settings → Widgets → Reviews. Move this section anywhere on the product page." }
] }
{% endschema %}
