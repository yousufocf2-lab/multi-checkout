<p class="price">{%- if compare > price -%}<span class="price__loop" role="group" aria-label="Sale price {{ price | money }}; regular price {{ compare | money }}"><span class="price__regular" aria-hidden="true">{{ compare | money }}</span><b class="price__sale" aria-hidden="true">{{ price | money }}</b></span>{%- else -%}<span class="price__now">{{ price | money }}</span>{%- endif -%}</p>
