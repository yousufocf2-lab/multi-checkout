    if(b.classList.contains('is-on')){body.value=v.replace(new RegExp('\\s*'+t.replace(/[.*+?^${}()|[\]\\]/g,'\\$&')+'\\.?','i'),'').trim()}else{body.value=(v.trim()?v.trim().replace(/[.!]?$/,'. '):'')+t+'.'}
