    r.innerHTML='<div style="display:flex;gap:1px;flex:none;padding-top:2px">'+h+'</div><div>'+(t?'<b>'+esc(t)+'</b>':'')+'<p>'+esc(body.value.trim())+'</p>'+(media.length?'<p>'+media.length+' file'+(media.length>1?'s':'')+' attached</p>':'')+'</div>';}
  function open(n){if(sent){location.reload();return}lastFocus=document.activeElement;modal.hidden=false;document.body.classList.add('rbx-lock');steps.forEach(function(s){s.hidden=true});done.hidden=true;steps[0].hidden=false;cur=0;
    next.hidden=false;if(n)setRating(n,false);go(n?1:0);if(!n)setTimeout(function(){var f=labels[0]&&labels[0].querySelector('input');if(f)f.focus({preventScroll:true})},80);}
  function close(){modal.hidden=true;document.body.classList.remove('rbx-lock');if(sent)location.reload();else if(lastFocus)lastFocus.focus({preventScroll:true})}
  box.addEventListener('click',function(e){var o=e.target.closest('[data-rbx-open]');if(o){e.preventDefault();open(+o.dataset.rbxOpen||0)}});
  document.addEventListener('click',function(e){var j=e.target.closest('[data-review-jump],a[href="#reviews"][data-review-jump]');if(j&&!box.closest('[hidden]')){e.preventDefault();box.scrollIntoView({behavior:'smooth'});setTimeout(function(){open(0)},350)}});
  modal.addEventListener('click',function(e){if(e.target.closest('[data-rbx-close]'))close();var g=e.target.closest('[data-rbx-go]');if(g)go(0,true)});
