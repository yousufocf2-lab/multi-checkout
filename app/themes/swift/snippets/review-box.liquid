  next.addEventListener('click',function(){if(next.disabled)return;if(cur<steps.length-1){go(cur+1);return}submit()});
  form.addEventListener('submit',function(e){e.preventDefault();if(!next.disabled)next.click()});
  form.addEventListener('keydown',function(e){if(e.key==='Enter'&&e.target.tagName==='INPUT'&&e.target.type!=='file'){e.preventDefault();next.click()}});
  function submit(){err.hidden=true;next.disabled=true;next.classList.add('is-busy');
    var fd=new FormData(form);fd.set('rating',String(rating));
