function esc(s){return String(s).replace(/[&<>"']/g,function(c){return{"&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;","'":"&#39;"}[c]})}
function init(box){
  // ----- list: filter, sort, show more, read more
  var list=box.querySelector('[data-rbx-list]'),items=list?[].slice.call(list.children):[],limit=6,filter='all';
  function paint(){var shown=0;items.forEach(function(it){var ok=filter==='all'||(filter==='media'?+it.dataset.mediaN>0:it.dataset.stars===filter);it.hidden=!ok||shown>=limit;if(ok&&shown<limit)shown++;});
    var total=items.filter(function(it){return filter==='all'||(filter==='media'?+it.dataset.mediaN>0:it.dataset.stars===filter)}).length;
    var more=box.querySelector('[data-rbx-more]');if(more)more.hidden=total<=limit;var none=box.querySelector('[data-rbx-none]');if(none)none.hidden=total>0;
    box.querySelectorAll('[data-rbx-filter]').forEach(function(b){b.classList.toggle('is-on',b.dataset.rbxFilter===filter)});
    items.forEach(function(it){var b=it.querySelector('[data-rbx-body]');if(!b||it.hidden||b.dataset.done)return;b.dataset.done=1;if(b.scrollHeight>b.clientHeight+4){var r=document.createElement('button');r.type='button';r.className='rbx__rm';r.textContent='Read more';r.onclick=function(){var o=b.classList.toggle('is-open');r.textContent=o?'Show less':'Read more'};b.after(r)}});}
  if(list){paint();
    box.addEventListener('click',function(e){var f=e.target.closest('[data-rbx-filter]');if(f){filter=f.dataset.rbxFilter;limit=6;paint();if(f.classList.contains('rbx__bar'))list.scrollIntoView({behavior:'smooth',block:'start'});}
      if(e.target.closest('[data-rbx-more]')){limit+=6;paint();}});
    var so=box.querySelector('[data-rbx-sort]');if(so)so.addEventListener('change',function(){var k=so.value;items.sort(function(a,b){if(k==='high')return b.dataset.stars-a.dataset.stars||a.dataset.i-b.dataset.i;if(k==='low')return a.dataset.stars-b.dataset.stars||a.dataset.i-b.dataset.i;if(k==='media')return b.dataset.mediaN-a.dataset.mediaN||a.dataset.i-b.dataset.i;return a.dataset.i-b.dataset.i});items.forEach(function(it){list.appendChild(it)});paint();});
  }
  // ----- lightbox
  box.addEventListener('click',function(e){var m=e.target.closest('[data-media]');if(!m)return;var v=m.dataset.type==='video',d=document.createElement('div');d.className='rbx-lb';d.innerHTML=(v?'<video src="'+esc(m.dataset.media)+'" controls autoplay playsinline></video>':'<img src="'+esc(m.dataset.media)+'" alt="">')+'<button type="button" aria-label="Close">×</button>';d.onclick=function(ev){if(ev.target===d||ev.target.tagName==='BUTTON')d.remove()};document.body.appendChild(d);});
  // ----- the step-by-step form
  var modal=box.querySelector('[data-rbx-modal]');if(!modal)return;
  var form=modal.querySelector('[data-rbx-form]');document.body.appendChild(modal);
  var steps=[].slice.call(form.querySelectorAll('.rbx-s')).filter(function(s){return s.dataset.step!=='done'});
  var done=form.querySelector('[data-step=done]'),bars=[].slice.call(form.querySelectorAll('.rbx-m__prog i'));
  var next=form.querySelector('[data-rbx-next]'),back=form.querySelector('[data-rbx-back]'),skip=form.querySelector('[data-rbx-skip]'),stepn=form.querySelector('[data-rbx-stepn]');
