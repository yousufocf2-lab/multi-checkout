      if(!r.ok)return r.text().then(function(t){throw new Error(t&&t.length<300?t:'Something went wrong. Please try again.')});
      var live=/review=published/.test(r.url);sent=true;steps.forEach(function(s){s.hidden=true});done.hidden=false;bars.forEach(function(b){b.classList.add('is-on')});
      stepn.textContent='';back.hidden=true;skip.hidden=true;next.classList.remove('is-busy');next.disabled=false;next.textContent='Done';next.onclick=function(){close()};
      var nm=nameIn.value.trim().split(' ')[0];form.querySelector('[data-rbx-thanks]').textContent='Thank you, '+nm+'!';
      form.querySelector('[data-rbx-donemsg]').textContent=live?'Your review is live now. It really helps other shoppers.':'We got your review. It will show here once the store has checked it.';
    }).catch(function(x){err.textContent=x.message||'Something went wrong. Please try again.';err.hidden=false;next.classList.remove('is-busy');check();});}
  // ----- photos and videos
  var files=form.querySelector('[data-rbx-files]');
  if(files){var thumbs=form.querySelector('[data-rbx-thumbs]'),hidden=form.querySelector('[data-rbx-media]'),hint=form.querySelector('[data-rbx-hint]'),drop=form.querySelector('[data-rbx-drop]');
    var maxV=parseInt(form.dataset.maxVideo||'30',10),maxM=parseInt(form.dataset.maxMedia||'4',10);
    var paintM=function(){hidden.value=JSON.stringify(media);thumbs.innerHTML=media.map(function(m,i){return'<span class="rbx-th">'+(m.type==='video'?'<video src="'+esc(m.url)+'#t=0.1" muted></video>':'<img src="'+esc(m.url)+'" alt="">')+'<button type="button" data-rm="'+i+'" aria-label="Remove">×</button></span>'}).join('')+new Array(uploading+1).join('<span class="rbx-th rbx-th--busy"></span>');skip.hidden=steps[cur].dataset.step!=='media'||media.length>0||uploading>0;check();};
    var dur=function(f){return new Promise(function(res){var v=document.createElement('video');v.preload='metadata';v.onloadedmetadata=function(){URL.revokeObjectURL(v.src);res(v.duration||0)};v.onerror=function(){res(0)};v.src=URL.createObjectURL(f)})};
    var add=function(list){hint.textContent='';[].slice.call(list).forEach(function(f){
      if(media.length+uploading>=maxM){hint.textContent='You can add up to '+maxM+' files.';return}
      if(files.accept&&files.accept.split(',').indexOf(f.type)<0){hint.textContent='That file type isn\u2019t allowed.';return}
      var isV=/^video\//.test(f.type);(isV?dur(f):Promise.resolve(0)).then(function(sec){
        if(isV&&sec>maxV+.5){hint.textContent='That video is '+Math.round(sec)+' seconds. Please keep it under '+maxV+' seconds.';return}
        uploading++;paintM();
        fetch('/api/review-media',{method:'POST',headers:{'Content-Type':f.type,'X-Store':form.dataset.store},body:f}).then(function(r){return r.json()})
          .then(function(d){if(d.url)media.push({url:d.url,type:d.type});else hint.textContent=d.error||'Upload failed.'})
          .catch(function(){hint.textContent='Upload failed. Please try again.'}).then(function(){uploading--;paintM()});});});};
    files.addEventListener('change',function(){add(files.files);files.value=''});
    ['dragenter','dragover'].forEach(function(t){drop.addEventListener(t,function(e){e.preventDefault();drop.classList.add('is-over')})});
    ['dragleave','drop'].forEach(function(t){drop.addEventListener(t,function(e){e.preventDefault();drop.classList.remove('is-over')})});
    drop.addEventListener('drop',function(e){if(e.dataTransfer)add(e.dataTransfer.files)});
    thumbs.addEventListener('click',function(e){var b=e.target.closest('[data-rm]');if(!b)return;media.splice(+b.dataset.rm,1);paintM()});}
}
function boot(){document.querySelectorAll('[data-rbx]').forEach(init)}
if(document.readyState==='loading')document.addEventListener('DOMContentLoaded',boot);else boot();
})();
</script>
