<div class="card-wrap" data-card data-product="{{ product.json | escape }}">
<a class="card" href="{{ product.url }}">
  <div class="card__media">
    {%- if product.featured_video -%}
    <video src="{{ product.featured_video }}" {% if product.featured_image %}poster="{{ product.featured_image | img_url: 600 }}"{% endif %} muted loop playsinline preload="metadata" data-inview-play aria-label="{{ product.title | escape }}"></video>
    {%- elsif product.featured_image -%}<img src="{{ product.featured_image | img_url: 600 }}" alt="{{ product.title | escape }}" loading="lazy" data-card-img>{%- endif -%}
    {%- if product.discount_pct > 0 and settings.card_show_discount != false -%}<span class="badge">{{ product.discount_pct }}% off</span>{%- endif -%}
    {%- unless product.available or product.demo -%}<span class="badge badge--muted">Sold out</span>{%- endunless -%}
  </div>
  <p class="card__title">{{ product.title }}</p>
  {% render 'snippets/price', price: product.price, compare: product.compare_at_price %}
</a>
{%- if product.available -%}
<div class="card__overlay"><button type="button" class="card__quick card__quick--{{ settings.card_icon_position | default: 'bottom-right' }}" data-quick-add aria-label="{% if product.demo %}Sample cart icon{% else %}Add {{ product.title | escape }} to cart{% endif %}"{% if product.demo %} disabled title="Preview item"{% endif %}>
  {%- case settings.card_icon_style -%}
  {%- when 'plus' -%}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" aria-hidden="true"><path d="M12 5v14M5 12h14"/></svg>
  {%- when 'trolley' -%}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 4h2.2l2.1 10.2a1.5 1.5 0 0 0 1.5 1.2h8.4a1.5 1.5 0 0 0 1.5-1.1L20 8H8.5"/><circle cx="9.5" cy="19.5" r="1.2"/><circle cx="17" cy="19.5" r="1.2"/><path d="M13.6 9.4v4M11.6 11.4h4"/></svg>
  {%- else -%}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4.5 9.5h15l-1.6 9.1a1.6 1.6 0 0 1-1.6 1.4H7.7a1.6 1.6 0 0 1-1.6-1.4z"/><path d="M8.5 9.5 11 4.5M15.5 9.5 13 4.5"/><path d="M12 12.6v4.4M9.8 14.8h4.4"/></svg>
  {%- endcase -%}
</button></div>
{%- if settings.card_show_quick_add and product.demo != true -%}<button type="button" class="btn btn--ghost card__add" data-quick-add>Add to cart</button>{%- endif -%}
{%- endif -%}
</div>
