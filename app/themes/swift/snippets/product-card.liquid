<a class="card" href="{{ product.url }}">
  <div class="card__media">
    {%- if product.featured_image -%}<img src="{{ product.featured_image | img_url: 600 }}" alt="{{ product.title | escape }}" loading="lazy">{%- endif -%}
    {%- if product.discount_pct > 0 -%}<span class="badge">{{ product.discount_pct }}% off</span>{%- endif -%}
    {%- unless product.available -%}<span class="badge badge--muted">Sold out</span>{%- endunless -%}
  </div>
  <p class="card__title">{{ product.title }}</p>
  {% render 'snippets/price', price: product.price, compare: product.compare_at_price %}
</a>
