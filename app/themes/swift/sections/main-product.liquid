<section class="pdp wrap pdp--{{ section.settings.gallery }} pdp--ratio-{{ section.settings.image_ratio }}{% if section.settings.media_right %} pdp--media-right{% endif %}{% if settings.preset == 'mira' %} pdp--mira{% elsif settings.preset == 'luma' %} pdp--luma{% endif %}">
  <div class="pdp__gallery">
    <div class="pdp__slides" data-slides>
      {%- for m in product.images -%}
      <div class="pdp__slide" id="m{{ forloop.index }}">
        {%- if m.type == 'video' -%}
        <video src="{{ m.src }}" {% if m.poster %}poster="{{ m.poster | img_url: 1100 }}"{% endif %} muted playsinline loop preload="metadata" data-inview-play></video>
        {%- else -%}
        <img {% if forloop.first %}id="pdp-main" fetchpriority="high"{% else %}loading="lazy"{% endif %} src="{{ m.src | img_url: 1100 }}" alt="{{ m.alt | escape }}">
        {%- endif -%}
      </div>
      {%- endfor -%}
    </div>
    {%- if product.images.size > 1 -%}
    <div class="pdp__thumbs">
      {%- for m in product.images -%}
      <button type="button" class="pdp__thumb" data-to="m{{ forloop.index }}" aria-label="{% if m.type == 'video' %}Video{% else %}Photo{% endif %} {{ forloop.index }}">
        {%- assign t = m.src -%}{%- if m.type == 'video' -%}{%- assign t = m.poster -%}{%- endif -%}
        {%- if t -%}<img src="{{ t | img_url: 160 }}" alt="" loading="lazy">{%- endif -%}
        {%- if m.type == 'video' -%}<span class="pdp__play" aria-hidden="true">▶</span>{%- endif -%}
      </button>
      {%- endfor -%}
    </div>
    {%- endif -%}
  </div>

  <div class="pdp__info">
    {%- assign blocks = section.settings.blocks -%}
    {%- for b in blocks -%}
    {%- case b.block -%}
    {%- when 'title' -%}
      {%- if b.text != blank -%}<p class="eyebrow">{{ b.text }}</p>{%- endif -%}
      <h1 class="pdp__title">{{ product.title }}</h1>
    {%- when 'rating' -%}
      <p class="pdp__rating"><span class="review__stars">★★★★★</span> {% if review_count > 0 %}{{ review_average }} / 5 · {{ review_count }} reviews{% else %}{{ b.text | default: 'Be the first to review this product' }}{% endif %}</p>
    {%- when 'price' -%}
      <div class="pdp__price" data-price>{% render 'snippets/price', price: product.price, compare: product.compare_at_price %}</div>
      {%- if product.discount_pct > 0 and section.settings.show_savings -%}<p class="save" data-save>You save {{ product.compare_at_price | minus: product.price | money }} ({{ product.discount_pct }}%)</p>{%- endif -%}
      {%- if b.text != blank -%}<p class="muted pdp__small">{{ b.text }}</p>{%- endif -%}
    {%- when 'offer' -%}
      {%- if b.text != blank -%}<div class="pdp__offer">{{ b.text }}</div>{%- endif -%}
    {%- when 'buy' -%}
    <form class="pdp__form" data-product-form>
      {%- for option in product.options -%}
      {%- assign oi = forloop.index0 -%}
      {%- if section.settings.variant_style == 'dropdown' -%}
      <label class="opt"><span class="opt__label">{{ option.name }}</span>
        <select class="select" name="option{{ oi }}">{%- for value in option.values -%}<option value="{{ value | escape }}">{{ value }}</option>{%- endfor -%}</select>
      </label>
      {%- else -%}
      <fieldset class="opt">
        <legend>{{ option.name }}</legend>
        <div class="opt__values">
          {%- for value in option.values -%}
          <label class="pill"><input type="radio" name="option{{ oi }}" value="{{ value | escape }}" {% if forloop.first %}checked{% endif %}><span>{{ value }}</span></label>
          {%- endfor -%}
        </div>
      </fieldset>
      {%- endif -%}
      {%- endfor -%}
      {%- if section.settings.show_qty -%}
      <div class="qty" aria-label="Quantity">
        <button type="button" data-qty="-1" aria-label="Less">−</button>
        <input type="number" name="qty" value="1" min="1" max="20" inputmode="numeric" aria-label="Quantity">
        <button type="button" data-qty="1" aria-label="More">+</button>
      </div>
      {%- else -%}<input type="hidden" name="qty" value="1">{%- endif -%}
      <p class="pdp__soldout" data-soldout hidden>This option is sold out.</p>
      {%- if product.demo -%}<p class="muted" style="margin:0">Sample item — this preview can’t place an order.</p><button type="button" class="btn btn--primary btn--block" disabled>Preview only</button>{%- else -%}
      <div class="pdp__buttons{% if section.settings.buttons_side %} pdp__buttons--row{% endif %}">
        {%- if section.settings.show_buy_now -%}<button type="submit" name="buy" value="now" class="btn btn--primary btn--block" data-buy>{{ section.settings.buy_label | default: 'Buy now' }}</button>{%- endif -%}
        {%- if section.settings.show_add_cart -%}<button type="submit" name="buy" value="cart" class="btn {% if section.settings.show_buy_now %}btn--ghost{% else %}btn--primary{% endif %} btn--block" data-add {% unless section.settings.show_buy_now %}data-buy{% endunless %}>{{ section.settings.cart_label | default: 'Add to cart' }}</button>{%- endif -%}
      </div>{%- endif -%}
    </form>
    {%- when 'highlights' -%}
      {%- assign src = b.text | default: settings.pdp_points -%}
      {%- assign points = src | newline_to_br | split: '<br />' -%}
      {%- if src != blank -%}
      <ul class="pdp__points">{%- for p in points -%}{%- assign t = p | strip -%}{%- if t != '' -%}<li>{{ t }}</li>{%- endif -%}{%- endfor -%}</ul>
      {%- endif -%}
    {%- when 'delivery' -%}
      <p class="pdp__delivery">🚚 {{ b.text | default: 'Delivered in 3–6 days. Cash on delivery available.' }}</p>
    {%- when 'trust' -%}
      <div class="pdp__trust"><span>✓ Cash on delivery</span><span>✓ Easy returns</span><span>✓ Secure payment</span></div>
    {%- when 'description' -%}
      {%- if product.description != blank -%}
      <details class="pdp__desc"{% if section.settings.desc_open %} open{% endif %}><summary>{{ b.text | default: 'Description' }}</summary><div class="rte">{{ product.description }}</div></details>
      {%- endif -%}
    {%- when 'text' -%}
      {%- if b.text != blank -%}<div class="rte pdp__text">{{ b.text }}</div>{%- endif -%}
    {%- when 'share' -%}
      <p class="pdp__share">Share: <a href="https://wa.me/?text={{ product.title | url_encode }}%20{{ product.url | url_encode }}" target="_blank" rel="noopener" data-share-link>WhatsApp</a> · <a href="#" data-copy-link>Copy link</a></p>
    {%- endcase -%}
    {%- endfor -%}
  </div>
</section>
<section class="reviews wrap" id="reviews">
  <h2>Customer reviews{% if review_count > 0 %} <span class="reviews__summary">{{ review_average }} / 5 · {{ review_count }}</span>{% endif %}</h2>
  {% if review_submitted %}<p class="reviews__notice">Thank you. Your review was sent for approval.</p>{% endif %}
  {% if reviews.size > 0 %}
    <div class="reviews__list">
      {% for review in reviews %}
        <article class="reviews__item">
          <p class="review__stars" aria-label="{{ review.rating }} out of 5 stars">{% if review.rating >= 1 %}★{% endif %}{% if review.rating >= 2 %}★{% endif %}{% if review.rating >= 3 %}★{% endif %}{% if review.rating >= 4 %}★{% endif %}{% if review.rating >= 5 %}★{% endif %}</p>
          <p>{{ review.body | escape }}</p><small>{{ review.authorName | escape }} · {{ review.createdAt | date: '%d %b %Y' }}</small>
        </article>
      {% endfor %}
    </div>
  {% endif %}
  {%- unless product.demo -%}<details class="reviews__write"><summary>Write a review</summary>
    <form method="post" class="reviews__form">
      <label>Name<input name="name" maxlength="80" required autocomplete="name"></label>
      <label>Email (optional)<input name="email" type="email" maxlength="254" autocomplete="email"></label>
      <label>Rating<select name="rating" required><option value="">Choose a rating</option><option value="5">5 — Excellent</option><option value="4">4 — Good</option><option value="3">3 — Average</option><option value="2">2 — Poor</option><option value="1">1 — Very poor</option></select></label>
      <label>Your review<textarea name="body" minlength="10" maxlength="2000" required rows="4"></textarea></label>
      <div class="reviews__trap" aria-hidden="true"><label>Leave this blank<input name="website" tabindex="-1" autocomplete="off"></label></div>
      <button class="btn btn--primary" type="submit">Submit review</button>
    </form>
  </details>{%- endunless -%}
</section>
<script type="application/json" id="product-json">{{ product.json }}</script>
{%- if settings.pdp_sticky_buy != false and product.demo != true -%}<div class="sticky-buy" data-sticky>
  <div><p class="sticky-buy__title">{{ product.title }}</p><p class="sticky-buy__price" data-sticky-price>{{ product.price | money }}</p></div>
  <button type="button" class="btn btn--primary" data-sticky-buy>{{ section.settings.buy_label | default: 'Buy now' }}</button>
</div>{%- endif -%}
{% schema %}
{ "name": "Product details", "settings": [
  { "id": "blocks", "type": "list", "label": "Blocks (drag order with the arrows)", "item_label": "block", "fields": [
    { "id": "block", "type": "select", "label": "Block", "options": ["title", "rating", "price", "offer", "buy", "highlights", "delivery", "trust", "description", "text", "share"], "option_labels": ["Title", "Star rating line", "Price", "Offer box", "Variants + Buy buttons", "Highlights (✓ list)", "Delivery info", "Trust row", "Description", "Custom text", "Share buttons"] },
    { "id": "text", "type": "textarea", "label": "Text (optional — depends on the block)" }
  ], "default": [
    { "block": "title", "text": "" },
    { "block": "price", "text": "Inclusive of all taxes" },
    { "block": "offer", "text": "Pay online and get extra 10% off" },
    { "block": "buy", "text": "" },
    { "block": "highlights", "text": "" },
    { "block": "delivery", "text": "" },
    { "block": "description", "text": "Description" }
  ] },
  { "id": "gallery", "type": "select", "label": "Photo layout", "default": "slider", "options": ["slider", "grid", "stack"], "option_labels": ["Slider with thumbnails", "Grid (2 per row on computer)", "One below the other"] },
  { "id": "image_ratio", "type": "select", "label": "Photo shape", "default": "square", "options": ["square", "portrait", "landscape", "natural"], "option_labels": ["Square", "Portrait (4:5)", "Landscape (4:3)", "Original shape"] },
  { "id": "media_right", "type": "checkbox", "label": "Photos on the right", "default": false },
  { "id": "variant_style", "type": "select", "label": "Variant picker", "default": "pills", "options": ["pills", "dropdown"], "option_labels": ["Buttons", "Dropdown"] },
  { "id": "show_qty", "type": "checkbox", "label": "Show quantity selector", "default": true },
  { "id": "show_buy_now", "type": "checkbox", "label": "Show “Buy now” button", "default": true },
  { "id": "buy_label", "type": "text", "label": "“Buy now” text", "default": "Buy now" },
  { "id": "show_add_cart", "type": "checkbox", "label": "Show “Add to cart” button", "default": true },
  { "id": "cart_label", "type": "text", "label": "“Add to cart” text", "default": "Add to cart" },
  { "id": "buttons_side", "type": "checkbox", "label": "Buttons side by side", "default": false },
  { "id": "show_savings", "type": "checkbox", "label": "Show “You save ₹…”", "default": true },
  { "id": "desc_open", "type": "checkbox", "label": "Description open by default", "default": true }
] }
{% endschema %}
