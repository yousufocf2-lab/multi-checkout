<header class="header">
  <div class="wrap header__row">
    {%- comment -%} The logo always fits inside the header bar: these limits are inline !important, so settings or custom CSS can't push it out {%- endcomment -%}
    <a href="{{ routes.root }}" class="header__logo" aria-label="{{ shop.name }} home" style="display:flex!important;align-items:center!important;height:48px!important;max-height:48px!important;overflow:hidden!important;flex:0 1 auto!important;min-width:0!important">
      {%- assign logo = settings.logo | default: shop.logo -%}
      {%- if logo -%}<img src="{{ logo }}" alt="{{ shop.name }}" style="display:block!important;width:auto!important;height:auto!important;max-height:48px!important;max-width:min(var(--logo-width,140px),46vw)!important;object-fit:contain!important;position:static!important;transform:none!important;margin:0!important">{%- else -%}<span style="display:block;max-width:46vw;overflow:hidden;text-overflow:ellipsis;white-space:nowrap">{{ shop.name }}</span>{%- endif -%}
    </a>
    <nav class="header__nav" aria-label="Main">
      {%- if section.settings.show_all -%}<a href="{{ routes.all }}">{{ section.settings.all_label }}</a>{%- endif -%}
      {%- for c in collections limit: section.settings.menu_count -%}<a href="{{ c.url }}">{{ c.title }}</a>{%- endfor -%}
    </nav>
    <a href="{{ routes.cart }}" class="header__cart" aria-label="Cart">
      <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 6h15l-2 9H8L6 3H3"/><circle cx="9" cy="20" r="1.3"/><circle cx="18" cy="20" r="1.3"/></svg>
      <span class="header__count" data-cart-count hidden>0</span>
    </a>
  </div>
</header>
{% schema %}
{ "name": "Header", "settings": [
  { "id": "show_all", "type": "checkbox", "label": "Show “Shop all” link", "default": true },
  { "id": "all_label", "type": "text", "label": "“Shop all” text", "default": "Shop all" },
  { "id": "menu_count", "type": "range", "label": "Categories in the menu", "min": 0, "max": 8, "step": 1, "default": 4 }
] }
{% endschema %}
