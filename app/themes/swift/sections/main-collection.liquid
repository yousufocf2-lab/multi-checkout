{%- assign use_filters = false -%}
{%- if section.settings.show_filters != false and collection.filters.enabled -%}{%- assign use_filters = true -%}{%- endif -%}
{%- assign lay = section.settings.filter_layout | default: 'store' -%}{%- if lay == 'store' -%}{%- assign lay = collection.filters.layout -%}{%- endif -%}
<section class="block">
  <div class="wrap">
    {%- if collection.search -%}
    <form action="{{ routes.search }}" method="get" class="srch-page" role="search">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/></svg>
      <input type="search" name="q" value="{{ collection.search.q | escape }}" placeholder="Search products" aria-label="Search products" autocomplete="off">
      <button type="submit">Search</button>
    </form>
    {%- if collection.search.categories.size > 0 -%}<p class="srch-cats">{%- for c in collection.search.categories -%}<a href="{{ c.url }}">{{ c.title }}</a>{%- endfor -%}</p>{%- endif -%}
    {%- endif -%}
    <div class="block__head">
      <h1>{{ collection.title }}</h1>
      {%- unless use_filters -%}<span class="muted">{{ collection.products.size }} products</span>{%- endunless -%}
    </div>
    {%- if collection.description != blank -%}<div class="rte muted">{{ collection.description }}</div>{%- endif -%}
    {%- capture grid -%}
    {%- if collection.products.size > 0 -%}
    <div class="grid">
      {%- for product in collection.products -%}{% render 'snippets/product-card', product: product %}{%- endfor -%}
    </div>
    {%- elsif collection.filters.active_count > 0 -%}
    <p class="empty">No products match these filters. <a href="{{ collection.filters.clear_url | escape }}" class="link">Clear filters</a></p>
    {%- else -%}
    <p class="empty">Nothing here yet. <a href="{{ routes.all }}" class="link">See all products</a></p>
    {%- endif -%}
    {%- endcapture -%}
    {%- if use_filters -%}{% render 'snippets/filters', f: collection.filters, grid: grid, layout: lay %}{%- else -%}{{ grid }}{%- endif -%}
  </div>
</section>
{% schema %}
{ "name": "Category page", "settings": [
  { "type": "paragraph", "id": "p_filters", "label": "Which filters show, their order and their look are set in Settings → Widgets → Product filters." },
  { "type": "checkbox", "id": "show_filters", "label": "Show product filters", "default": true },
  { "type": "select", "id": "filter_layout", "label": "Filter position", "default": "store", "options": ["store", "sidebar", "top", "drawer"], "option_labels": ["Use store setting", "Sidebar", "Top bar", "Slide-out panel"] }
] }
{% endschema %}
