        <p class="demo-bag__name">The Market Carryall</p><p class="demo-bag__price">₹2,290 <s>₹2,990</s></p>
      </a>
      <a class="demo-bag" href="{{ routes.base }}/product/mira-mini-crossbody?gp_preset=mira">
        <div class="demo-bag__art" style="background:#eee9f0"><svg viewBox="0 0 240 260" fill="none" aria-hidden="true"><path d="M87 104c0-31 12-49 33-49s33 18 33 49" stroke="#493d4e" stroke-width="9" stroke-linecap="round"/><path d="M68 109h104l-7 106H75l-7-106Z" fill="#85748d"/><path d="M68 109h104l-5 20H73l-5-20Z" fill="#a392ac"/><path d="M91 153h58v40H91z" fill="#78677f"/><path d="M112 163h16v18h-16z" fill="#d4bd9c"/><path d="M93 214l-13 18m67-18 13 18" stroke="#493d4e" stroke-width="6" stroke-linecap="round"/></svg><span class="demo-bag__cart" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M4.5 9.5h15l-1.6 9.1a1.6 1.6 0 0 1-1.6 1.4H7.7a1.6 1.6 0 0 1-1.6-1.4z"/><path d="M8.5 9.5 11 4.5M15.5 9.5 13 4.5"/></svg></span></div>
        <p class="demo-bag__name">The Mini Crossbody</p><p class="demo-bag__price">₹1,490 <s>₹1,990</s></p>
      </a>
      <a class="demo-bag" href="{{ routes.base }}/product/mira-city-satchel?gp_preset=mira">
        <div class="demo-bag__art" style="background:#f2ebdc"><svg viewBox="0 0 240 260" fill="none" aria-hidden="true"><path d="M82 98c0-29 14-48 38-48s38 19 38 48" stroke="#554538" stroke-width="9" stroke-linecap="round"/><path d="M58 105h124l-9 119H67l-9-119Z" fill="#c19b62"/><path d="M58 105h124l-5 21H63l-5-21Z" fill="#d4b47e"/><path d="M95 151h50v43H95z" fill="#b38d55"/><path d="m120 158 8 12-8 12-8-12 8-12Z" fill="#eed5a8"/><path d="M75 209h90" stroke="#d4b47e" stroke-width="5" stroke-linecap="round"/></svg><span class="demo-bag__cart" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M4.5 9.5h15l-1.6 9.1a1.6 1.6 0 0 1-1.6 1.4H7.7a1.6 1.6 0 0 1-1.6-1.4z"/><path d="M8.5 9.5 11 4.5M15.5 9.5 13 4.5"/></svg></span></div>
        <p class="demo-bag__name">The City Satchel</p><p class="demo-bag__price">₹2,090 <s>₹2,790</s></p>
      </a>
    </div>
  </div>
</section>
