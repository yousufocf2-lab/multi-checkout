{%- if demo_theme == 'mira' -%}
<section class="block demo-products" aria-label="{{ section.settings.heading | escape }}">
  <div class="wrap">
    <div class="demo-products__head">
      <h2>{{ section.settings.heading | default: "The bag edit" | escape }}</h2>
      <p>Everyday pieces, thoughtfully chosen</p>
    </div>
    <div class="demo-products__grid">
      <a class="demo-bag" href="{{ routes.base }}/product/mira-sunday-tote?gp_preset=mira">
        <div class="demo-bag__art" style="background:#f2e6df"><svg viewBox="0 0 240 260" fill="none" aria-hidden="true"><path d="M74 94c0-31 18-52 46-52s46 21 46 52" stroke="#51352f" stroke-width="10" stroke-linecap="round"/><path d="M54 100h132l-10 126H64L54 100Z" fill="#ad7063"/><path d="M54 100h132l-7 19H61l-7-19Z" fill="#c58c7e"/><path d="M101 142h38v31h-38z" fill="#d9b99a"/><path d="M108 149h24v17h-24z" fill="#7c5149"/><path d="M72 202h96" stroke="#c58c7e" stroke-width="5" stroke-linecap="round"/></svg><span class="demo-bag__cart" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M4.5 9.5h15l-1.6 9.1a1.6 1.6 0 0 1-1.6 1.4H7.7a1.6 1.6 0 0 1-1.6-1.4z"/><path d="M8.5 9.5 11 4.5M15.5 9.5 13 4.5"/></svg></span></div>
        <p class="demo-bag__name">The Sunday Tote</p><p class="demo-bag__price">₹1,890 <s>₹2,490</s></p>
      </a>
      <a class="demo-bag" href="{{ routes.base }}/product/mira-market-carryall?gp_preset=mira">
