<section class="trust">
  <div class="wrap trust__row">
    {%- for b in section.settings.items -%}
    <div class="trust__item">
      <svg class="trust__icon" width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="{{ b.icon }}"/></svg>
      <span><b>{{ b.title }}</b><small>{{ b.text }}</small></span>
    </div>
    {%- endfor -%}
  </div>
</section>
{% schema %}
{
  "name": "Trust badges",
  "settings": [
    { "id": "items", "type": "list", "label": "Badges", "default": [
      { "icon": "M2 6h11v10H2zM13 10h5l3 3v3h-8M6 19a2 2 0 1 0 0-4 2 2 0 0 0 0 4zM17 19a2 2 0 1 0 0-4 2 2 0 0 0 0 4z", "title": "Fast delivery", "text": "Ships in 24 hours" },
      { "icon": "M3 7h18v10H3zM12 15a3 3 0 1 0 0-6 3 3 0 0 0 0 6zM6 10v.01M18 14v.01", "title": "Cash on delivery", "text": "Pay when it arrives" },
      { "icon": "M9 14L4 9l5-5M4 9h11a5 5 0 0 1 0 10h-3", "title": "Easy returns", "text": "7-day return policy" },
      { "icon": "M6 11h12v9H6zM8 11V7a4 4 0 0 1 8 0v4", "title": "Secure payment", "text": "UPI, cards, net banking" }
    ] }
  ]
}
{% endschema %}
