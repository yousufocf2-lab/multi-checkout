# Railway Postgres -> reference variable: ${{Postgres.DATABASE_URL}}
DATABASE_URL=postgres://user:pass@host:5432/railway
# Public URL of this checkout app (no trailing slash)
APP_URL=https://checkout.yourdomain.com
# Admin panel login
ADMIN_PASSWORD=change-me
# Long random string for cookie signing
SESSION_SECRET=replace-with-a-long-random-string
# Super admin login email (default "admin")
ADMIN_EMAIL=admin
# Set to false to stop store owners signing up themselves
ALLOW_SIGNUP=true
# Owner signup / login OTP by email (Resend). "test" = code is always 123456 (for trying the flow)
RESEND_API_KEY=
MAIL_FROM=Growpefy <no-reply@growpefy.com>
# SMS OTP uses the MSG91 key from All wallets → Settings → Messaging (or MSG91_AUTH_KEY / MSG91_OTP_TEMPLATE_ID here)
# Google Ads ("Connect with Google" on the Ads page). Google Cloud project with the Google Ads API enabled,
# OAuth client (Web application) with redirect URI  https://growpefy.com/google/callback
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
# Optional: only for older API versions that still read it; Google now manages access per Cloud project
GOOGLE_ADS_DEVELOPER_TOKEN=
# Optional: Google Ads API version (default v25)
GOOGLE_ADS_API_VERSION=
# Search engines: ownership tags on the homepage (only if you verify with the "HTML tag" method)
GOOGLE_SITE_VERIFICATION=
BING_SITE_VERIFICATION=
